# Runtime
APP_ENV=development
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
VERCEL_APP_NAME=

# Production secret bootstrap (set on EC2, not inside the JSON secret)
AWS_REGION=us-east-1
AWS_SECRET_ARN=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=course-documents
SUPABASE_STORAGE_PUBLIC_BASE=

# AI and retrieval
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Must equal the Pinecone index dimension. The production index is 3072.
OPENAI_EMBEDDING_DIMENSIONS=3072
ANTHROPIC_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=
COHERE_API_KEY=
MATH_OCR_PROVIDER=auto
INGEST_PIPELINE_VERSION=v2

# Queues and cache
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# Optional media providers
ELEVENLABS_API_KEY=
DEFAULT_NARRATION_VOICE_ID=
DID_API_KEY=
DID_BASE_URL=https://api.d-id.com
TAVUS_API_KEY=
TAVUS_DEFAULT_REPLICA_ID=
WEBHOOK_SECRET=

# Rendering
RENDERER=manim
RENDER_NARRATION=1
MANIM_QUALITY=-qm
MANIM_RENDER_TIMEOUT=600
